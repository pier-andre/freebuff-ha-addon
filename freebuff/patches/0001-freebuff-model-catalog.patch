+func buildCatalogIndex(catalog *modelCatalog) (map[string]ModelTarget, []string, []string, error) {
+	targets := make(map[string]ModelTarget, len(catalog.Rows)*3)
+	models := make([]string, 0, len(catalog.Rows))
+	agents := make([]string, 0, 1)
+	seenAgent := make(map[string]struct{})
+	seenDisplay := make(map[string]int)
+
+	for _, row := range catalog.Rows {
+		if strings.TrimSpace(row.Handle) == "" || strings.TrimSpace(row.DisplayName) == "" {
+			continue
+		}
+		if strings.EqualFold(row.Access, "locked") {
+			continue
+		}
+		if row.OpensAt > 0 && catalog.IssuedAt > 0 && row.OpensAt > catalog.IssuedAt {
+			continue
+		}
+
+		display := strings.TrimSpace(row.DisplayName)
+		seenDisplay[display]++
+		if seenDisplay[display] > 1 {
+			display = fmt.Sprintf("%s (%s)", display, strings.TrimSpace(row.Key))
+		}
+
+		target := ModelTarget{
+			AgentID: freebuffCatalogRootAgentID,
+			Model:   strings.TrimSpace(row.Handle),
+			Key:     strings.TrimSpace(row.Key),
+			Display: display,
+		}
+		models = append(models, display)
+		targets[strings.ToLower(display)] = target
+		if key := strings.TrimSpace(row.Key); key != "" {
+			targets[strings.ToLower(key)] = target
+		}
+		targets[strings.ToLower(target.Model)] = target
+		if _, ok := seenAgent[target.AgentID]; !ok {
+			seenAgent[target.AgentID] = struct{}{}
+			agents = append(agents, target.AgentID)
+		}
+	}
+
+	if len(models) == 0 {
+		return nil, nil, nil, fmt.Errorf("catalog listed no usable models")
+	}
+	sort.Strings(models)
+	return targets, models, agents, nil
+}
